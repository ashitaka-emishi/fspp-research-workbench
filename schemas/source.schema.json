{
  "$defs": {
    "CorpusTier": {
      "enum": [
        "tier1",
        "tier2",
        "tier3"
      ],
      "title": "CorpusTier",
      "type": "string"
    },
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "change_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Note"
        },
        "status": {
          "$ref": "#/$defs/RecordStatus",
          "default": "draft"
        },
        "superseded_by": {
          "items": {
            "type": "string"
          },
          "title": "Superseded By",
          "type": "array"
        },
        "supersedes": {
          "items": {
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "Lineage",
      "type": "object"
    },
    "RecordStatus": {
      "enum": [
        "draft",
        "reviewed",
        "released",
        "superseded",
        "deprecated"
      ],
      "title": "RecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accessed_at": {
      "format": "date-time",
      "title": "Accessed At",
      "type": "string"
    },
    "acquisition_date": {
      "format": "date",
      "title": "Acquisition Date",
      "type": "string"
    },
    "archival_citation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Archival Citation"
    },
    "bibliographic_citation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bibliographic Citation"
    },
    "canonical_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Url"
    },
    "capture_method": {
      "enum": [
        "manual_metadata_review",
        "downloaded_file",
        "static_html_scrape",
        "browser_rendered_capture",
        "ocr_text",
        "manual_transcription"
      ],
      "title": "Capture Method",
      "type": "string"
    },
    "checksum_scope": {
      "enum": [
        "local_file",
        "remote_file",
        "metadata_record"
      ],
      "title": "Checksum Scope",
      "type": "string"
    },
    "checksum_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum Sha256",
      "type": "string"
    },
    "copyright_status": {
      "title": "Copyright Status",
      "type": "string"
    },
    "corpus_tier": {
      "$ref": "#/$defs/CorpusTier"
    },
    "edition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Edition"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "local_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Path"
    },
    "original_language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Language"
    },
    "provenance_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance Notes"
    },
    "publication_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Date"
    },
    "publication_year": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Year"
    },
    "redistribution_status": {
      "title": "Redistribution Status",
      "type": "string"
    },
    "repository": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_kind": {
      "title": "Source Kind",
      "type": "string"
    },
    "source_location_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Location Name"
    },
    "source_reliability": {
      "enum": [
        "high",
        "medium",
        "low",
        "uncertain"
      ],
      "title": "Source Reliability",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "translation_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Notes"
    },
    "translation_source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translation Source Id"
    },
    "translation_status": {
      "default": "unknown",
      "enum": [
        "original_language",
        "human_translation",
        "machine_translation",
        "mixed_translation",
        "not_applicable",
        "unknown"
      ],
      "title": "Translation Status",
      "type": "string"
    },
    "translator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translator"
    }
  },
  "required": [
    "source_id",
    "title",
    "source_kind",
    "corpus_tier",
    "acquisition_date",
    "accessed_at",
    "capture_method",
    "checksum_sha256",
    "checksum_scope",
    "language",
    "copyright_status",
    "redistribution_status",
    "source_reliability"
  ],
  "title": "Source",
  "type": "object"
}
