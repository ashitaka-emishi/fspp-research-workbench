      "title": "Evidence Chain Id",
      "type": "string"
    },
    "mechanism_component_ids": {
      "items": {
        "type": "string"
      },
      "title": "Mechanism Component Ids",
      "type": "array"
    },
    "negative_evidence_ids": {
      "items": {
        "type": "string"
      },
