{
  "$defs": {
    "Lineage": {
      "additionalProperties": false,
      "properties": {
        "change_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Note"
        },
        "status": {
          "$ref": "#/$defs/RecordStatus",
          "default": "draft"
        },
        "superseded_by": {
          "items": {
            "type": "string"
          },
          "title": "Superseded By",
          "type": "array"
        },
        "supersedes": {
          "items": {
            "type": "string"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "version": {
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "Lineage",
      "type": "object"
    },
    "RecordStatus": {
      "enum": [
        "draft",
        "reviewed",
        "released",
        "superseded",
        "deprecated"
      ],
      "title": "RecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonical_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Url"
    },
    "capture_method": {
      "enum": [
        "downloaded_file",
        "static_html_scrape",
        "browser_rendered_capture",
        "ocr_text",
        "manual_transcription"
      ],
      "title": "Capture Method",
      "type": "string"
    },
    "capture_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capture Notes"
    },
    "captured_at": {
      "format": "date-time",
      "title": "Captured At",
      "type": "string"
    },
    "coordinate_scope": {
      "enum": [
        "page_text",
        "document_text",
        "source_text"
      ],
      "title": "Coordinate Scope",
      "type": "string"
    },
    "copyright_status": {
      "title": "Copyright Status",
      "type": "string"
    },
    "document_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Id"
    },
    "full_text_capture_id": {
      "title": "Full Text Capture Id",
      "type": "string"
    },
    "lineage": {
      "$ref": "#/$defs/Lineage"
    },
    "local_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Path"
    },
    "page_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Label"
    },
    "redistribution_status": {
      "title": "Redistribution Status",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_location_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Location Name"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "text_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Text Hash",
      "type": "string"
    }
  },
  "required": [
    "full_text_capture_id",
    "source_id",
    "coordinate_scope",
    "text",
    "text_hash",
    "capture_method",
    "captured_at",
    "copyright_status",
    "redistribution_status"
  ],
  "title": "FullTextCapture",
  "type": "object"
}
